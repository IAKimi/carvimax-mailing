# =============================================================================
# PostIAlo Mailing — Variables de entorno
# =============================================================================
# Copia este archivo como `.env` para desarrollo local fuera de Replit, o
# carga estas variables como Secrets en el panel de Replit (Tools → Secrets).
# NUNCA commitees el archivo `.env` con valores reales.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUERIDAS — La app no arranca sin estas
# -----------------------------------------------------------------------------

# URL de conexión a PostgreSQL.
# En Replit: se provisiona automáticamente al crear una base de datos en
# Tools → Database. NO usar la DATABASE_URL de producción (VPS/Coolify).
DATABASE_URL=postgresql://user:password@host:port/database

# Secret para firmar cookies de sesión Y para derivar la clave de encriptación
# AES-256-GCM que protege las API keys de proveedores de email (Brevo,
# Mailchimp) guardadas en la DB.
# CRÍTICO: Si rotás este valor, TODAS las API keys guardadas dejan de
# poder descifrarse y los usuarios tendrán que reconectar sus proveedores.
# Generar con: `openssl rand -hex 32` o cualquier string aleatorio largo.
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars

# API key de OpenAI. Se usa para generar el texto de los correos con
# `gpt-4.1-mini` (Responses API + Structured Outputs).
OPENAI_API_KEY=sk-...

# API key de Google Gemini. Se usa para generar y editar imágenes:
#   - Modelo principal: gemini-3.1-flash-image-preview (16:9)
#   - Fallback: gemini-2.0-flash
GEMINI_API_KEY=AIza...


# -----------------------------------------------------------------------------
# WEBHOOKS DE MAKE.COM — Necesarias para verificación de email y tracking
# -----------------------------------------------------------------------------

# URL del webhook de Make.com que recibe el payload de verificación de email
# cuando un usuario se registra o pide reenvío.
# OJO: si NO se setea, el código cae a una URL hardcodeada del proyecto
# original. Configurala SIEMPRE en una cuenta nueva para no enviar tráfico
# al webhook de otra organización.
# Payload enviado:
#   { type: "verification", email, name, company, verificationLink }
MAKE_VERIFICATION_WEBHOOK_URL=https://hook.eu2.make.com/your-webhook-id

# Secret compartido para validar los webhooks que Make.com envía DE VUELTA
# a la app (callbacks de progreso de envío de campañas, etc.).
# Este valor también está declarado en `.replit` bajo [userenv.shared];
# cualquiera de los dos lugares funciona, pero ambos deben coincidir con
# lo configurado en Make.com.
MAKE_WEBHOOK_SECRET=your-shared-secret


# -----------------------------------------------------------------------------
# OPCIONALES — Tienen defaults razonables
# -----------------------------------------------------------------------------

# Override del baseUrl que la app usa para construir links absolutos
# (verificación de email, callbacks, etc.). Si no se setea, se infiere de
# REPLIT_DOMAINS o cae a localhost:5000.
# Útil cuando el proyecto corre detrás de un dominio custom (Coolify/VPS).
APP_URL=https://tu-dominio.com
PRODUCTION_URL=https://tu-dominio.com

# Puerto del servidor Express. En Replit dejalo en 5000 (mapea a 80 externo).
PORT=5000

# Entorno de ejecución. En `production` se habilitan cookies seguras
# (secure: true), trust proxy, y el seed automático de la DB.
NODE_ENV=development

# Auto-provisto por Replit en runtime. Lista de dominios separados por coma.
# No es necesario setearlo manualmente; existe solo como fallback.
# REPLIT_DOMAINS=tu-repl.replit.app
